# Template for group_vars/{test,production}/secrets.yml
#
# These files are ansible-vault encrypted and are NOT derivable from git history.
# Copy this file's keys into a plaintext secrets.yml, fill in real values, then encrypt:
#
#   cp group_vars/secrets.yml.example group_vars/production/secrets.yml
#   # edit group_vars/production/secrets.yml with real values
#   ansible-vault encrypt group_vars/production/secrets.yml --vault-password-file <(echo "$VAULT_PASSWORD")
#
# Repeat for group_vars/test/secrets.yml with test-environment values.
# The $VAULT_PASSWORD must match the VAULT_PASSWORD secret configured on the
# memelo-test / memelo-production GitHub Environments (used by .github/workflows/cd.yml).
---
# --- Server / proxy (server_setup role) ---
proxy_domain: ""          # public domain the app is served on, e.g. app.example.com
webhook_domain: ""        # public domain for the telegram webhook, e.g. hooks.example.com
certbot_email: ""         # email used for Let's Encrypt cert registration
nginx_htpasswd_user: ""   # basic-auth username protecting the proxy
nginx_htpasswd_password: ""  # basic-auth password protecting the proxy

# --- Telegram (telegram-service) ---
telegram_token: ""              # bot token from @BotFather
telegram_webhook_externalurl: ""  # public https URL telegram will POST updates to

# --- Webapp (webapp-service) ---
webapp_account_id: ""    # account id the webapp operates as
webapp_jwt_secret: ""    # signing secret for webapp JWTs

# --- YouTube (youtube-service) ---
youtube_provider_apikey: ""  # API key for the youtube download provider

# --- Postgres (auth-service, telegram-service) ---
postgres_user: ""
postgres_password: ""

# --- S3 / media storage (storage-service, telegram-service, youtube-service, ffmpeg-service) ---
s3_access_key: ""
s3_secret_key: ""

# --- Elasticsearch (storage-service) ---
elastic_cloudid: ""
elastic_apikey: ""

# --- LLM providers (storage-service) ---
gemini_api_key: ""
openrouter_api_key: ""
